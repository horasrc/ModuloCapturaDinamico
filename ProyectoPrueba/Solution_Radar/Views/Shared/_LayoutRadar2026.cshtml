@*
    LAYOUT DE PRUEBA que imita a _LayoutRadar2026 del portal.
    NO copiar a la solución real (allá ya existe el layout original).

    Igual que el layout real:
      - jQuery 3.7.1 + Bootstrap 5.3.2 bundle ANTES del RenderBody.
      - Después del RenderBody se vuelven a cargar jQuery y bootstrap.js (sin Popper).
    Así la prueba refleja las mismas condiciones del portal.
*@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@ViewBag.Title - Radar (prueba local)</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body>
    <header style="background:#1d1d1f;color:#fff;padding:10px 16px;display:flex;justify-content:space-between;align-items:center">
        <strong>Radar · Prueba local del módulo Captura Dinámica</strong>
        <span style="font-size:13px">
            <a href="@Url.Action("Administrador", "CapturasDinamicas")" style="color:#fff;margin-right:14px">Administrador</a>
            <a href="@Url.Action("Captura", "CapturasDinamicas", new { id = 1 })" style="color:#fff">Captura encuesta 1</a>
        </span>
    </header>

    <!-- jQuery 3.7.1 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap 5.3.2 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Objeto Token simulado (en el portal lo crea Scripts/Token/Page.js) -->
    <script>
        window.Token = {
            NumEmpleado: 12345678,
            NombreEmpleado: 'Usuario de Prueba',
            Puesto: 'Head of Branch Network',
            Cencos: 3200,
            Nivel: 'Nacional',
            Privilegios: 'Acceso'
        };
    </script>

    <div>
        @RenderBody()
    </div>

    <!-- Segunda carga, como en el layout real -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js"></script>
</body>
</html>
