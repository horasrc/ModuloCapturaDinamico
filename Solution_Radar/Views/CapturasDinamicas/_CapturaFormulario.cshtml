@*
    Vista parcial: formulario que contesta el usuario final.
    Requiere ViewBag.IdEncuesta. Incluye su CSS y sus scripts.
*@
<link href="@Url.Content("~/CSS/Page2026/CapturasDinamicas/CapturasDinamicas.css")?v=1.1.0" rel="stylesheet" />

<div class="cd-modulo">
    <div id="cdCapturaContenido" style="max-width:860px;margin:0 auto"></div>
</div>

<script src="@Url.Content("~/Scripts/CapturasDinamicas/cd.core.js")?v=1.1.0"></script>
<script src="@Url.Content("~/Scripts/CapturasDinamicas/cd.api.js")?v=1.1.0"></script>
<script src="@Url.Content("~/Scripts/CapturasDinamicas/cd.renderer.js")?v=1.1.0"></script>
<script src="@Url.Content("~/Scripts/CapturasDinamicas/cd.captura.js")?v=1.1.0"></script>
<script>
    CD.config.urls.obtenerCaptura = '@Url.Action("ObtenerCaptura", "CapturasDinamicas")';
    CD.config.urls.guardarRespuesta = '@Url.Action("GuardarRespuesta", "CapturasDinamicas")';
    CD.config.urls.buscarPorLlave = '@Url.Action("BuscarPorLlave", "CapturasDinamicas")';
    CD.config.urls.calendario = '@Url.Action("DescargarCalendario", "CapturasDinamicas")';
    jQuery(function () { CD.Captura.init({ idEncuesta: @ViewBag.IdEncuesta }); });
</script>
