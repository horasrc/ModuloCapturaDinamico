@*
    2. CONSTRUCTOR DE PREGUNTAS
    [ Lista de preguntas + Lógica de la encuesta ] [ Panel de edición ] [ Vista previa de la pregunta + Tipos de pregunta ]
*@
<div class="row g-3">

    <!-- COLUMNA 1: lista de preguntas -->
    <div class="col-12 col-lg-4 col-xxl-3">
        <div class="cd-card">
            <div class="cd-card-header">
                <span>Preguntas <span class="cd-contador" id="cdTotalPreguntas">0</span></span>
                <span class="small text-cd-muted fw-normal"><i class="bi bi-grip-vertical"></i> Arrastra para ordenar</span>
            </div>
            <ul class="cd-lista-preguntas" id="cdListaPreguntas"></ul>
            <div class="p-3">
                <button type="button" class="btn-cd-agregar" id="cdBtnAgregarPregunta"><i class="bi bi-plus-lg me-1"></i>Agregar pregunta</button>
            </div>
        </div>

        <div class="cd-card">
            <div class="cd-card-header"><span><i class="bi bi-signpost-split me-2"></i>Lógica de la encuesta</span></div>
            <div class="cd-card-body" id="cdResumenLogica"></div>
        </div>
    </div>

    <!-- COLUMNA 2: panel de configuración de la pregunta -->
    <div class="col-12 col-lg-8 col-xxl-5">
        <div class="cd-card cd-panel" id="cdPanelCard">
            <div class="cd-card-header">
                <span>Editar pregunta <span class="cd-num ms-1" id="cdPanelNumero"></span></span>
                <div id="cdPanelBotones" class="d-flex gap-1">
                    <button type="button" class="btn btn-cd-icono" id="cdBtnSubir" title="Subir"><i class="bi bi-arrow-up"></i></button>
                    <button type="button" class="btn btn-cd-icono" id="cdBtnBajar" title="Bajar"><i class="bi bi-arrow-down"></i></button>
                    <button type="button" class="btn btn-cd-icono" id="cdBtnDuplicar" title="Duplicar"><i class="bi bi-files"></i></button>
                    <button type="button" class="btn btn-cd-icono peligro" id="cdBtnEliminar" title="Eliminar"><i class="bi bi-trash"></i></button>
                </div>
            </div>
            <div class="cd-card-body" id="cdPanelPregunta"></div>
        </div>
    </div>

    <!-- COLUMNA 3: vista previa de la pregunta + catálogo de tipos -->
    <div class="col-12 col-xxl-4">
        <div class="row g-3">
            <div class="col-12 col-md-6 col-xxl-12">
                <div class="cd-card mb-0 h-100">
                    <div class="cd-card-header"><span><i class="bi bi-eye me-2"></i>Vista previa de la pregunta</span></div>
                    <div class="cd-card-body" id="cdPreviewPregunta"></div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xxl-12">
                <div class="cd-card mb-0 h-100">
                    <div class="cd-card-header"><span>Tipos de pregunta</span><span class="small text-cd-muted fw-normal">Clic para agregar</span></div>
                    <div class="cd-card-body"><div class="cd-tipos-grid" id="cdTiposGrid"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>
