@* 1. ENCABEZADO: nombre, estatus, versión, acciones principales y pestañas *@
<div class="cd-encabezado">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">

        <div class="flex-grow-1" style="min-width:260px">
            <a class="cd-volver" data-cd-volver-listado="1" href="@Url.Action("Administrador", "CapturasDinamicas")"><i class="bi bi-chevron-left"></i> Encuestas</a>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                <h1 class="cd-titulo"><span class="cd-titulo-prefijo">Encuesta:</span> <span id="cdNombreEncuesta">...</span></h1>
                <button type="button" class="cd-editar-nombre" id="cdBtnEditarNombre" title="Editar nombre"><i class="bi bi-pencil"></i></button>
                <span id="cdBadgeEstatus"></span>
                <span class="cd-badge cd-badge-version" id="cdBadgeVersion" title="Ver historial de versiones"><i class="bi bi-clock-history me-1"></i>Versión</span>
                <span class="cd-badge cd-badge-sucio cd-oculto" id="cdBadgeSucio"><i class="bi bi-circle-fill me-1" style="font-size:7px"></i>Cambios sin guardar</span>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-cd-borde" id="cdBtnVistaPrevia"><i class="bi bi-eye me-1"></i>Vista previa</button>
            <button type="button" class="btn btn-cd-borde" id="cdBtnGuardar"><i class="bi bi-save me-1"></i>Guardar borrador</button>
            <button type="button" class="btn btn-cd-rojo" id="cdBtnPublicar"><i class="bi bi-send me-1"></i>Publicar encuesta</button>
            <div class="cd-menu">
                <button type="button" class="btn btn-cd-icono" style="width:38px;height:38px" data-cd-menu="1" title="Más opciones"><i class="bi bi-three-dots-vertical"></i></button>
                <div class="cd-menu-lista">
                    <button type="button" class="cd-menu-item" data-cd-accion="historial"><i class="bi bi-clock-history"></i>Historial de versiones</button>
                    <button type="button" class="cd-menu-item" data-cd-accion="captura"><i class="bi bi-box-arrow-up-right"></i>Abrir pantalla de captura</button>
                    <div class="cd-menu-sep"></div>
                    <button type="button" class="cd-menu-item" data-cd-accion="cerrar"><i class="bi bi-lock"></i>Cerrar encuesta</button>
                    <button type="button" class="cd-menu-item" data-cd-accion="reabrir"><i class="bi bi-unlock"></i>Reabrir encuesta</button>
                    <button type="button" class="cd-menu-item peligro" data-cd-accion="archivar"><i class="bi bi-archive"></i>Archivar encuesta</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Aviso de versionado (lo llena cd.editor.js) -->
    <div class="alert alert-light border small mt-3 mb-0 cd-oculto" id="cdAvisoVersion"></div>

    <!-- Pestañas (controladas por cd.editor.js, no usan data-bs-toggle) -->
    <div class="cd-tabs">
        <button type="button" class="cd-tab activo" data-cd-tab="constructor"><i class="bi bi-grid-1x2"></i>Constructor</button>
        <button type="button" class="cd-tab" data-cd-tab="configuracion"><i class="bi bi-sliders2"></i>Configuración</button>
        <button type="button" class="cd-tab" data-cd-tab="preview"><i class="bi bi-phone"></i>Vista previa</button>
        <button type="button" class="cd-tab" data-cd-tab="resultados"><i class="bi bi-bar-chart"></i>Resultados</button>
    </div>
</div>
